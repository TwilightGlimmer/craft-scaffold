# Default deny; deliberately expose only reviewed publication files.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/python.sh
!/requirements-stage1.in
!/requirements.lock.txt
!/requirements-formal.txt
!/docs/
/docs/*
!/docs/*.md
!/docs/*.json
!/docs/*.patch
!/tools/
/tools/*
!/tools/check_publication.py
!/configs/
/configs/*
!/configs/recovery-v1.config.yaml
!/scripts/
/scripts/*
!/scripts/curriculum_env.py
!/scripts/curriculum_adapter.py
!/scripts/exact_replay.py
!/scripts/training_runtime.py
!/scripts/curriculum_train.py
!/scripts/curriculum_evaluate.py
!/scripts/analyze_curriculum_evaluation.py
!/scripts/curriculum_formal_worker.py
!/scripts/test_curriculum_env.py
!/dreamerv3/
!/dreamerv3/**
/dreamerv3/scores/*.gz
!/reports/
/reports/*
!/reports/curriculum-v1/
/reports/curriculum-v1/*
!/reports/curriculum-v1/protocol-frozen.json
!/reports/curriculum-v1/release-lock.json
!/reports/curriculum-v1/dependencies.json
!/reports/curriculum-v1/environment-tests.json
!/reports/curriculum-v1/adapter-tests.json
!/reports/curriculum-v1/replay-tests.json
!/reports/curriculum-v1/full-resume-gate.json
!/reports/curriculum-v1/preflight-gate.json
!/reports/curriculum-v1/development-evaluation/
/reports/curriculum-v1/development-evaluation/*
!/reports/curriculum-v1/development-evaluation/diagnostic-gate.json
# Defense in depth.
**/__pycache__/
*.py[cod]
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
*.pkl
*.pt
*.pth
*.ckpt
*.npz
*.log
.DS_Store
